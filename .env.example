# Database Driver: "sqlite" (default, no network needed) or "postgres"
DB_DRIVER=sqlite

# SQLite (used when DB_DRIVER=sqlite)
SQLITE_DB_PATH=./data/database.sqlite

# PostgreSQL (used when DB_DRIVER=postgres, e.g. for production)
DATABASE_URL=postgresql://username:password@localhost:5432/tkp-people-connect

# JWT
JWT_SECRET=your-jwt-secret-key-min-32-characters-long
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-characters-long

# App
APP_URL=http://localhost:3000
NODE_ENV=development

# AWS SES (for email - falls back to console logging if not configured)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
EMAIL_FROM=noreply@tkp-people-connect.com

# AI Provider (all free - no paid subscriptions needed)
# Options: "ollama" (default, local/free), "gemini" (free tier, 20 req/day),
#          "groq" (free tier, ~1000 req/day), "auto" (auto-detect)
AI_PROVIDER=auto

# AI Embedding Provider (optional, defaults to same as AI_PROVIDER)
# Only needed when chat provider doesn't support embeddings (e.g., Groq)
# Options: "gemini", "ollama"
AI_EMBED_PROVIDER=

# Ollama (100% free, runs locally - https://ollama.com)
# Install: ollama pull nomic-embed-text && ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.1

# Google Gemini Free Tier (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Groq Free Tier (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
